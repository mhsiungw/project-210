# Local-only template for uploading GitHub Actions secrets.
# Copy to .github/.secrets.ci (gitignored), fill in values, then run:
#   gh secret set -f .github/.secrets.ci

SUPABASE_ACCESS_TOKEN=
SUPABASE_STAGING_PROJECT_REF=
# SUPABASE_PROD_PROJECT_REF=

# Vercel — only the prod project is driven from CI.
# Staging Vercel project uses native Git integration and needs no secrets here.
# VERCEL_TOKEN: Account-level token from https://vercel.com/account/tokens
# VERCEL_ORG_ID + VERCEL_PROJECT_ID_PROD: from the prod project's Settings → General
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID_PROD=
