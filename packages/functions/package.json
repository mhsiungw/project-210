{
  "name": "@app/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "supabase --workdir ../.. functions deploy api",
    "serve": "supabase --workdir ../.. functions serve api --env-file ../../env/.env.development.functions --no-verify-jwt",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@app/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/cloudfront-signer": "^3.1045.0",
    "@supabase/supabase-js": "^2.105.4",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^4.0.0"
  }
}
