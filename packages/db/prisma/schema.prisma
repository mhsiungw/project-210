generator client {
  provider            = "prisma-client"
  output              = "../generated/client"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  total_pages  Int?
  current_page Int?
  file_name    String        @default("")
  user_id      String        @db.Uuid
  translations Translation[]
  highlights   Highlight[]
  s3_key         String  @default("")
  s3_preview_key String  @default("")

  @@map("books")
}

model Highlight {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  book_id    String   @db.Uuid
  page       Int // 1-based page number
  rects      Json // [{ x, y, w, h }] normalized 0..1 to the unscaled page viewport
  text       String // captured selection (the vocab word / sentence)
  note       String? // optional user note
  color      String? // optional; default applied in app, no picker UI in v1
  books      Book     @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([book_id, page])
  @@map("highlights")
}

model Translation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  book_id    String   @unique @db.Uuid
  text       String?
  books      Book     @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("translations")
}
