{
  "name": "electron-app",
  "version": "1.0.0",
  "description": "Production-ready Electron + React + Redux Toolkit",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
