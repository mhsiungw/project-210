{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/renderer",
    "rootDir": "renderer/src",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "@renderer/*": ["./renderer/src/*"],
      "@app/shared": ["../shared/src"],
      "@app/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["renderer/src/**/*"],
  "references": [{ "path": "../shared" }]
}
