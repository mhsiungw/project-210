{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": [],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@app/ui": ["../ui/src/index.ts"],
      "@app/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
