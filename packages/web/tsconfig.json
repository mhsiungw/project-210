{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "@web/*": ["./src/*"],
      "@app/db": ["../db/src"],
      "@app/db/dto": ["../db/src/dto.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../db" }]
}
