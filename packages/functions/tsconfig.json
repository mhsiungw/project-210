{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "api",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@app/db": ["../db/src"],
      "@app/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["api/**/*"],
  "references": [{ "path": "../db" }, { "path": "../shared" }]
}
