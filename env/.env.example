# Template for `env/.env.<environment>` files. COMMITTED.
# Copy to env/.env.development / .env.staging / .env.production and fill in.
# Grouped by consumer. Entries marked `# secret` should be kept out of any
# committed file in real deployments (use .env.<env>.local + CI secrets).

# --- Renderer (VITE_-prefixed → inlined into renderer bundle, treat as public) ---
# Consumed by: packages/desktop/renderer, packages/web, packages/shared (auth client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_SENTRY_DSN=

# --- Functions / SST deploy (packages/functions) ---
# Consumed by: packages/functions/sst.config.ts at deploy time, and the deployed Lambdas.
SUPABASE_URL=
WEB_ORIGIN=
# Mirror of VITE_SUPABASE_ANON_KEY for non-renderer consumers.
SUPABASE_ANON_KEY=         # secret (treated as such in this project)

# --- Database / Prisma (packages/db) ---
# DATABASE_URL: runtime client via pgbouncer.
# DIRECT_URL:   direct connection for `prisma migrate`.
DATABASE_URL=              # secret
DIRECT_URL=                # secret

# --- AWS CLI / SDK (SST deploy + Lambda runtime) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=         # secret
AWS_SECRET_ACCESS_KEY=     # secret

# --- Supabase CLI (project management, migrations) ---
SUPABASE_ACCESS_TOKEN=     # secret
SUPABASE_PROJECT_REF=
# Dev only: local Inbucket UI for auth emails (http://127.0.0.1:54324/).
SUPABASE_MAIL_SERVER=

# --- Vercel deploy (CI only — staging/production bundles) ---
# Consumed by .github/workflows/deploy-web.yml after materialising the bundle
# secret (WEB_ENV_STAGING / WEB_ENV_PRODUCTION). Not used locally.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=              # secret
