# Template for `env/.env.<environment>.functions` (overlay for `supabase functions serve`).
# COMMITTED as a template; the real file is GITIGNORED.
#
# The functions runtime runs inside Docker, so DATABASE_URL / DIRECT_URL must be
# container-reachable (host.docker.internal instead of 127.0.0.1). This file
# overrides ONLY those two vars; everything else is inherited from the matching
# .env.<environment> + .env.<environment>.local pair.

DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
