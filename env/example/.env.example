# Template for `env/.env.<environment>` files (non-secret values). COMMITTED.
# Copy to env/.env.development / .env.staging / .env.production and fill in.
# Secrets live in the matching `.env.<environment>.local` file — see .env.example.local.

# --- Storage (main process only) ---
CLOUDFRONT_BASE_URL=
S3_BUCKET=
# CloudFront signed-URL key pair (create in AWS console → CloudFront → Key management).
# Attach the public key to a key group, then attach the key group to the distribution's
# default behavior with "Restrict viewer access" enabled.
CLOUDFRONT_KEY_PAIR_ID=

# --- Supabase (main process) ---
SUPABASE_URL=
# Dev only: local Inbucket UI for auth emails (http://127.0.0.1:54324/).
SUPABASE_MAIL_SERVER=

# --- AWS (main process; access keys go in .env.<env>.local) ---
AWS_REGION=

# --- Web origin (functions/CORS) ---
WEB_ORIGIN=

# --- Renderer (VITE_-prefixed → inlined into renderer bundle, treat as public) ---
VITE_SUPABASE_URL=
VITE_API_URL=
VITE_SENTRY_DSN=
