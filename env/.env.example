# Template for env files. COMMITTED.
# Copy to env/.env.development (for local dev) or fill staging/production equivalents.

# --- Database (main process only) ---
DATABASE_URL=
DIRECT_URL=

# --- Storage (main process only) ---
CLOUDFRONT_BASE_URL=
S3_BUCKET=

# --- OAuth (main process only — secrets) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_FOR_DEKTOP_SECRET=
GOOGLE_OAUTH_CLIENT_FOR_WEB_SECRET=
SUPABASE_AUTH_CALLBACK_URL=

# --- Supabase (main process only) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Renderer (VITE_-prefixed → inlined into renderer bundle, treat as public) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=

# --- Build-time only (Sentry source map upload) ---
# Lives in env/.env.sentry-build-plugin instead — see that file.
