{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../env/.env.development -- prisma generate",
    "migrate:dev": "dotenv -e ../../env/.env.development -- prisma migrate dev",
    "migrate:staging": "dotenv -e ../../env/.env.staging -- prisma migrate deploy",
    "migrate:production": "dotenv -e ../../env/.env.production -- prisma migrate deploy",
    "studio": "dotenv -e ../../env/.env.development -- prisma studio",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0"
  }
}
