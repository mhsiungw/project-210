{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@app/db": ["../db/src"],
      "@app/shared/*": ["../shared/src/*"],
      "@app/web-server/*": ["../web-server/src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../db" }, { "path": "../shared" }]
}
