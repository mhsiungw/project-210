{
  "name": "electron-app",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Electron + React + Redux Toolkit",
  "packageManager": "pnpm@9.15.0",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "prisma generate --config packages/db/prisma.config.ts",
    "dev": "pnpm run dev:desktop & pnpm run dev:web & pnpm run dev:server",
    "dev:desktop": "electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "dev:web": "pnpm --filter @app/web dev",
    "dev:server": "pnpm --filter @app/web-server dev",
    "build": "electron-vite build --config packages/desktop/electron.vite.config.ts && electron-builder --config packages/desktop/electron-builder.yml",
    "build:unpack": "electron-vite build --config packages/desktop/electron.vite.config.ts && electron-builder --dir --config packages/desktop/electron-builder.yml",
    "preview": "electron-vite preview --config packages/desktop/electron.vite.config.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --build",
    "typecheck:legacy": "tsc --noEmit",
    "test": "vitest run --config packages/shared/vitest.config.ts && vitest run --config packages/desktop/vitest.config.ts && pnpm --filter @app/web-server test",
    "test:renderer": "vitest --config packages/shared/vitest.config.ts",
    "test:main": "vitest --config packages/desktop/vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@reduxjs/toolkit": "^2.4.0",
    "@remixicon/react": "^4.9.0",
    "@sentry/electron": "^7.13.0",
    "@sentry/react": "10.50.0",
    "@sentry/vite-plugin": "^5.2.1",
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pdf": "^10.4.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.5"
  }
}
